# Declared environment for this project. Checked in; no values here.
# Declare every variable the project reads. Mark secrets @sensitive. Put local
# values in .env.local (gitignored). Validate with `pnpm env:check`; the infra
# scripts (`pnpm run plan|deploy|destroy`) inject values via `varlock run`.
#
# `pnpm dev` and the tests need none of these: Alchemy runs the Worker and D1
# locally. They only matter when talking to Cloudflare.
#
# @defaultRequired=false
# @defaultSensitive=true
# ---

# Cloudflare account to deploy into. For CI; locally, `alchemy profile edit`
# (see README) stores credentials instead.
# @type=string
# @sensitive=false
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token with Workers and D1 edit rights. For CI, like above.
# @type=string
CLOUDFLARE_API_TOKEN=

# Alchemy stage to deploy; unset uses `dev_$USER`. Pass `--stage` to override.
# @type=string
# @sensitive=false
ALCHEMY_STAGE=

# Alchemy credentials profile (`alchemy profile create <name>`); unset uses `default`.
# @type=string
# @sensitive=false
ALCHEMY_PROFILE=
