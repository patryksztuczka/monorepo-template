{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/block-git-hook-bypass.ts\"",
            "statusMessage": "Checking git command"
          }
        ]
      }
    ]
  }
}
