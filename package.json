{
  "name": "example-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript && lefthook install",
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "test": "vp test",
    "test:unit": "vp test --project unit",
    "test:integration": "vp test --project integration",
    "test:lint-rules": "node --test --test-isolation=none tools/oxlint/effect-style/rules/*.test.ts",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "varlock load && vp check",
    "env:check": "varlock load",
    "typecheck": "vp run -r typecheck",
    "db:generate": "pnpm --filter @example/database db:generate",
    "plan": "pnpm --filter @example/infra run plan",
    "deploy": "pnpm --filter @example/infra run deploy",
    "destroy": "pnpm --filter @example/infra run destroy"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "catalog:",
    "lefthook": "2.1.16",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "varlock": "1.20.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
