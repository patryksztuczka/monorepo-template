{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" },
    { "name": "anti-slop-effect", "specifier": "./tools/oxlint/anti-slop/effect/index.ts" },
    { "name": "effect-style", "specifier": "./tools/oxlint/effect-style/index.ts" }
  ],
  "rules": {
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "effect-style/bounded-concurrency": "error",
    "effect-style/branded-ids": "error",
    "effect-style/effect-fn-name": "error",
    "effect-style/fork-detach-reason": "error",
    "effect-style/layer-config-only-in-roots": "error",
    "effect-style/layer-naming": "error",
    "effect-style/log-literal-message": "error",
    "effect-style/no-ambient-date": "error",
    "effect-style/no-decode-sync": "error",
    "effect-style/no-error-instanceof": "error",
    "effect-style/no-error-subclass": "error",
    "effect-style/no-new-promise": "error",
    "effect-style/no-throw": "error",
    "effect-style/no-throw-in-effect": "error",
    "effect-style/no-try-in-tests": "error",
    "effect-style/no-untyped-failure": "error",
    "effect-style/redacted-secrets": "error",
    "effect-style/retry-requires-while": "error",
    "effect-style/run-only-in-entry-points": "error",
    "effect-style/service-explicit-shape": "error",
    "effect-style/service-id-matches-path": "error",
    "effect-style/tagged-error-naming": "error",
    "effect-style/try-requires-catch": "error",
    "import/no-unassigned-import": "off",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }]
  },
  "ignorePatterns": [
    "node_modules/",
    ".turbo/",
    "dist/",
    "coverage/",
    "packages/database/drizzle/",
    ".agent-sources/",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ],
  "overrides": [
    {
      "files": ["tools/oxlint/effect-style/**"],
      "rules": {
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-shape-in-symbol-names": "off"
      }
    },
    {
      "files": ["apps/web/**", "packages/ui/**"],
      "plugins": ["react"],
      "rules": {
        "react/react-in-jsx-scope": "off"
      }
    }
  ]
}
